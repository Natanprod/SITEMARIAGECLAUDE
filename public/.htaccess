# ==========================================================================
# Natan — configuration Apache / LiteSpeed (Hostinger)
# Le site est entièrement statique : ce fichier ne fait que trois choses,
# l'ordre des pages d'accueil, la page 404, et la mise en cache.
# ==========================================================================

# --- 1. La page d'accueil -------------------------------------------------
# Par défaut, le serveur sert index.php AVANT index.html. Si un ancien
# index.php traîne dans public_html, c'est lui qui s'affiche et le site
# reste invisible. On remet index.html en tête.
DirectoryIndex index.html index.php

# --- 2. La page « cette page n'existe pas » -------------------------------
ErrorDocument 404 /404.html

# --- 3. Cache ------------------------------------------------------------
# Les fichiers de _next/static portent une empreinte dans leur nom : ils ne
# changent jamais sans changer de nom, on peut donc les garder un an.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Les pages, elles, doivent pouvoir changer : une heure suffit.
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- 4. Compression ------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 5. Forcer HTTPS -----------------------------------------------------
# NE PAS ACTIVER CE BLOC CHEZ HOSTINGER.
#
# hPanel possède son propre interrupteur : Sécurité → SSL → bouton à trois
# points en face du domaine → « Forcer HTTPS ». C'est celui-là qu'il faut
# employer. Il est plus sûr, il se désactive d'un clic, et Hostinger peut
# écrire sa propre règle dans ce fichier — deux règles concurrentes sont
# la cause classique de la boucle de redirection.
#
# Le bloc ci-dessous n'est qu'un secours, pour un hébergeur qui n'offrirait
# pas l'interrupteur. Dans ce cas seulement, et seulement APRÈS que le
# certificat fonctionne, retirer les « # » des quatre lignes.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
